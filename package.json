{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "private": "true",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "dbmate up",
    "db:down": "dbmate rollback",
    "db:new": "tsx scripts/db-new.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.1.1",
    "cors": "^2.8.6",
    "dbmate": "^2.34.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pg-query-stream": "^4.17.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
